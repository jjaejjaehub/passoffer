{
  "name": "oms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @oms/web dev",
    "dev:server": "bun run --filter @oms/server dev",
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@fastify/env": "^5.0.3"
  }
}
