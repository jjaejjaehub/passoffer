## 2. shadcn/ui 컴포넌트 → Chakra UI 변환

### Button

```tsx
// ❌ 변환 전 (shadcn)
import { Button } from '@/components/ui/button';
<Button variant="outline" size="sm" disabled={isLoading}>저장</Button>

// ✅ 변환 후 (Chakra)
import { Button } from '@chakra-ui/react';
<Button variant="outline" size="sm" isDisabled={isLoading}>저장</Button>
```

주요 prop 변환:
- `disabled` → `isDisabled`
- `loading` → `isLoading`
- variant: `"default"` → `"solid"`, `"outline"` → `"outline"`, `"ghost"` → `"ghost"`, `"destructive"` → `colorScheme="red"`

### Input

```tsx
// ❌ 변환 전
import { Input } from '@/components/ui/input';
<Input placeholder="이메일" className="w-full" />

// ✅ 변환 후
import { Input } from '@chakra-ui/react';
<Input placeholder="이메일" w="full" />
```

### Label + Input (폼 필드)

```tsx
// ❌ 변환 전
import { Label } from '@/components/ui/label';
<div className="flex flex-col gap-1">
  <Label htmlFor="email">이메일</Label>
  <Input id="email" />
  <p className="text-sm text-red-500">{errors.email?.message}</p>
</div>

// ✅ 변환 후
import { FormControl, FormLabel, Input, FormErrorMessage } from '@chakra-ui/react';
<FormControl isInvalid={Boolean(errors.email)}>
  <FormLabel htmlFor="email">이메일</FormLabel>
  <Input id="email" {...register('email')} />
  <FormErrorMessage>{errors.email?.message}</FormErrorMessage>
</FormControl>
```

### Card

```tsx
// ❌ 변환 전
import { Card, CardHeader, CardContent, CardFooter } from '@/components/ui/card';
<Card>
  <CardHeader><h3>제목</h3></CardHeader>
  <CardContent>내용</CardContent>
  <CardFooter>푸터</CardFooter>
</Card>

// ✅ 변환 후
import { Box, Heading, Divider } from '@chakra-ui/react';
<Box borderWidth="1px" borderRadius="lg" overflow="hidden">
  <Box p={4} borderBottomWidth="1px">
    <Heading size="md">제목</Heading>
  </Box>
  <Box p={4}>내용</Box>
  <Box p={4} borderTopWidth="1px">푸터</Box>
</Box>
```

### Dialog / Modal

```tsx
// ❌ 변환 전
import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog';
<Dialog open={isOpen} onOpenChange={setIsOpen}>
  <DialogContent>
    <DialogHeader><DialogTitle>제목</DialogTitle></DialogHeader>
    {children}
  </DialogContent>
</Dialog>

// ✅ 변환 후
import {
  Modal, ModalOverlay, ModalContent,
  ModalHeader, ModalBody, ModalCloseButton,
} from '@chakra-ui/react';
<Modal isOpen={isOpen} onClose={() => setIsOpen(false)}>
  <ModalOverlay />
  <ModalContent>
    <ModalHeader>제목</ModalHeader>
    <ModalCloseButton />
    <ModalBody>{children}</ModalBody>
  </ModalContent>
</Modal>
```

### Select

```tsx
// ❌ 변환 전
import { Select, SelectContent, SelectItem, SelectTrigger } from '@/components/ui/select';

// ✅ 변환 후
import { Select } from '@chakra-ui/react';
<Select placeholder="선택하세요">
  <option value="a">옵션 A</option>
</Select>
```

### Checkbox / Switch

```tsx
// ❌ 변환 전
import { Checkbox } from '@/components/ui/checkbox';
import { Switch } from '@/components/ui/switch';

// ✅ 변환 후
import { Checkbox, Switch } from '@chakra-ui/react';
// prop 변환: checked → isChecked, onCheckedChange → onChange
```

### Badge

```tsx
// ❌ 변환 전
import { Badge } from '@/components/ui/badge';
<Badge variant="destructive">오류</Badge>

// ✅ 변환 후
import { Badge } from '@chakra-ui/react';
<Badge colorScheme="red">오류</Badge>
```

### Separator

```tsx
// ❌ 변환 전
import { Separator } from '@/components/ui/separator';
<Separator />

// ✅ 변환 후
import { Divider } from '@chakra-ui/react';
<Divider />
```

### Skeleton

```tsx
// ❌ 변환 전
import { Skeleton } from '@/components/ui/skeleton';
<Skeleton className="h-4 w-full" />

// ✅ 변환 후
import { Skeleton } from '@chakra-ui/react';
<Skeleton height="4" width="full" />
```

### Toast / Alert

```tsx
// ❌ 변환 전 (sonner or shadcn toast)
import { toast } from 'sonner';
toast.success('저장되었습니다');
toast.error('오류가 발생했습니다');

// ✅ 변환 후
import { useToast } from '@chakra-ui/react';
const toast = useToast();
toast({ title: '저장되었습니다', status: 'success', duration: 3000, isClosable: true });
toast({ title: '오류가 발생했습니다', status: 'error', duration: 5000, isClosable: true });
```

