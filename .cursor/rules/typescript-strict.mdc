### TanStack Query — queryKey 타입 안전성 + 반환 타입

queryKey는 query factory 패턴으로 타입 안전하게 관리한다.
`useQuery` / `useMutation`에 타입 파라미터를 명시한다.

```ts
// src/entities/user/api/userQueries.ts

// ✅ query factory — queryKey 중앙 관리, 타입 자동 추론
export const userQueries = {
  all:    ()                     => ['users'] as const,
  lists:  ()                     => [...userQueries.all(), 'list'] as const,
  list:   (filters: UserFilters) => [...userQueries.lists(), filters] as const,
  detail: (id: string)           => [...userQueries.all(), 'detail', id] as const,
};

// ✅ useQuery — queryFn 반환 타입 명시
export function useUser(id: string) {
  return useQuery({
    queryKey: userQueries.detail(id),
    queryFn:  (): Promise<User> => http.get(`/users/${id}`),
    enabled:  Boolean(id),
  });
}

// ✅ useMutation — <TData, TError, TVariables> 명시
export function useUpdateUser() {
  return useMutation<User, AxiosError<ApiErrorResponse>, UpdateUserInput>({
    mutationFn: (input) => http.put(`/users/${input.id}`, input),
  });
}
```

여러 쿼리를 조합하는 훅도 반환 타입을 명시한다.

```ts
// ✅ 조합 훅의 반환 타입 명시
function useUserWithPosts(id: string): {
  user:      User | undefined;
  posts:     Post[];
  isLoading: boolean;
  error:     Error | null;
} {
  const userQuery  = useUser(id);
  const postsQuery = useUserPosts(id);

  return {
    user:      userQuery.data,
    posts:     postsQuery.data ?? [],
    isLoading: userQuery.isLoading || postsQuery.isLoading,
    error:     userQuery.error ?? postsQuery.error,
  };
}
```

