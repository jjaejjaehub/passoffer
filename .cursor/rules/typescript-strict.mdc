### React Hook Form — zod 스키마로 타입과 검증 단일 소스 유지

`useForm<T>` 제네릭을 반드시 명시하고, `z.infer<typeof schema>`로
타입과 스키마를 한 파일에서 관리한다. 타입을 별도로 직접 작성하지 않는다.

```ts
// src/features/auth-login/model/loginSchema.ts
import { z } from 'zod';

export const loginSchema = z.object({
  email:    z.string().email('올바른 이메일을 입력하세요'),
  password: z.string().min(8, '비밀번호는 8자 이상'),
});

// ✅ 타입은 스키마에서 자동 추론 — 별도로 interface/type 작성 금지
export type LoginFormValues = z.infer<typeof loginSchema>;
```

```tsx
// src/features/auth-login/ui/LoginForm.tsx
import { useForm, SubmitHandler } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { loginSchema, LoginFormValues } from '../model/loginSchema';

function LoginForm() {
  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<LoginFormValues>({
    resolver:      zodResolver(loginSchema),
    defaultValues: { email: '', password: '' },
  });

  // ✅ SubmitHandler<T>로 onSubmit 타입 명시
  const onSubmit: SubmitHandler<LoginFormValues> = async (data) => {
    // data는 LoginFormValues 타입 보장
  };

  return <form onSubmit={handleSubmit(onSubmit)}>{/* ... */}</form>;
}
```

