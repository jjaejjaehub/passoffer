### Suspense + ErrorBoundary 선언적 처리

TanStack Query와 함께 사용할 때 `suspense: true` 옵션으로 선언적으로 처리한다.

```tsx
// ✅ Suspense + ErrorBoundary 조합
import { Suspense } from 'react';
import { ErrorBoundary } from 'react-error-boundary';
import { Skeleton } from '@chakra-ui/react';

export function UserSection({ id }: { id: string }) {
  return (
    <ErrorBoundary
      fallbackRender={({ error, resetErrorBoundary }) => (
        <ErrorFallback message={error.message} onReset={resetErrorBoundary} />
      )}
    >
      <Suspense fallback={<Skeleton height="200px" />}>
        <UserProfileSuspense id={id} />
      </Suspense>
    </ErrorBoundary>
  );
}
```

