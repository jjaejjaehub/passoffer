### TanStack Query — 에러 상태 처리 패턴

`useQuery`의 `error` 상태를 반드시 처리한다.
전역 에러는 `QueryClient` defaultOptions로, 로컬 에러는 컴포넌트에서 처리한다.

```ts
// src/app/_providers/QueryProvider.tsx — 전역 에러 기본 처리
const [queryClient] = useState(() => new QueryClient({
  defaultOptions: {
    queries: {
      staleTime: 60_000,
      retry: (failureCount, error) => {
        // 401/403/404는 재시도 안 함
        if (isAxiosError(error)) {
          const status = error.response?.status;
          if (status === 401 || status === 403 || status === 404) return false;
        }
        return failureCount < 2;
      },
    },
  },
}));
```

```tsx
// ✅ 컴포넌트에서 isLoading / error / data 3가지 상태 모두 처리
'use client'
function UserProfile({ id }: { id: string }) {
  const { data: user, isLoading, error } = useUser(id);

  // 로딩 상태
  if (isLoading) return <UserSkeleton />;

  // 에러 상태 — error를 무시하거나 data만 조건부 렌더링하지 않는다
  if (error) {
    const message = isAxiosError<ApiErrorResponse>(error)
      ? error.response?.data.message ?? '사용자 정보를 불러올 수 없습니다'
      : '알 수 없는 오류가 발생했습니다';
    return <ErrorMessage message={message} />;
  }

  return <Box>{user.name}</Box>;
}
```

```tsx
// ✅ useMutation — onError 콜백으로 에러 처리 + Chakra UI toast
'use client'
import { useToast } from '@chakra-ui/react';

function useUpdateUserWithToast() {
  const toast = useToast();

  return useMutation<User, AxiosError<ApiErrorResponse>, UpdateUserInput>({
    mutationFn: (input) => http.put(`/users/${input.id}`, input),

    onSuccess: () => {
      toast({ title: '저장되었습니다', status: 'success', duration: 3000 });
    },

    onError: (error) => {
      const message = error.response?.data.message ?? '저장에 실패했습니다';
      toast({ title: message, status: 'error', duration: 5000, isClosable: true });
    },
  });
}
```

