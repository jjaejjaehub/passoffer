### React Hook Form — 에러 상태를 Chakra UI FormControl과 연결

React Hook Form의 `errors` 객체는 반드시 `FormErrorMessage`와 연결한다.
유효성 검증 에러와 서버 에러를 구분해서 처리한다.

```tsx
'use client'
import {
  FormControl, FormLabel, Input,
  FormErrorMessage, Button, Alert, AlertIcon,
} from '@chakra-ui/react';
import { useForm, SubmitHandler } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';

function LoginForm() {
  const [serverError, setServerError] = useState<string | null>(null);

  const {
    register,
    handleSubmit,
    setError,  // ✅ 서버 에러를 특정 필드에 연결할 때 사용
    formState: { errors, isSubmitting },
  } = useForm<LoginFormValues>({
    resolver: zodResolver(loginSchema),
  });

  const onSubmit: SubmitHandler<LoginFormValues> = async (data) => {
    setServerError(null); // 이전 서버 에러 초기화

    try {
      await loginMutation.mutateAsync(data);
    } catch (error) {
      if (isAxiosError<ApiErrorResponse>(error)) {
        const apiError = error.response?.data;

        // ✅ 필드별 서버 에러 → setError로 특정 필드에 연결
        if (apiError?.errors) {
          Object.entries(apiError.errors).forEach(([field, messages]) => {
            setError(field as keyof LoginFormValues, { message: messages[0] });
          });
          return;
        }

        // ✅ 전체 폼 에러 → 별도 Alert으로 표시
        setServerError(apiError?.message ?? '로그인에 실패했습니다');
      }
    }
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      {/* ✅ 서버 에러는 폼 상단 Alert으로 표시 */}
      {serverError && (
        <Alert status="error" mb={4}>
          <AlertIcon />
          {serverError}
        </Alert>
      )}

      {/* ✅ 필드 에러는 FormControl isInvalid + FormErrorMessage로 처리 */}
      <FormControl isInvalid={Boolean(errors.email)} mb={4}>
        <FormLabel>이메일</FormLabel>
        <Input {...register('email')} />
        <FormErrorMessage>{errors.email?.message}</FormErrorMessage>
      </FormControl>

      <FormControl isInvalid={Boolean(errors.password)} mb={4}>
        <FormLabel>비밀번호</FormLabel>
        <Input type="password" {...register('password')} />
        <FormErrorMessage>{errors.password?.message}</FormErrorMessage>
      </FormControl>

      <Button type="submit" isLoading={isSubmitting} colorScheme="blue" w="full">
        로그인
      </Button>
    </form>
  );
}
```

